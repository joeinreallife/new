{
  "name": "dispatch-cockpit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "web:start": "npm run build && node server.mjs",
    "share:live": "concurrently -k \"npm run web:start\" \"wait-on tcp:127.0.0.1:8787 && npx localtunnel --port 8787\"",
    "desktop:dev": "concurrently -k \"vite --host 127.0.0.1 --port 4173\" \"wait-on tcp:127.0.0.1:4173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:4173 electron .\"",
    "desktop:start": "npm run build && electron .",
    "desktop:build": "npm run build && electron-packager . \"Dispatch Cockpit\" --platform=win32 --arch=x64 --out=release --overwrite --prune=true --ignore=\"^/release$\" --ignore=\"^/src$\" --ignore=\"^/public$\" --ignore=\"^/scripts$\"",
    "import:assignments": "node ./scripts/import-agg-truck-assign.mjs",
    "import:orders": "node ./scripts/import-shipped-order-summary.mjs",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electron/packager": "^18.3.6",
    "@eslint/js": "^9.9.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^41.1.0",
    "electron-builder": "^24.13.3",
    "eslint": "^9.9.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.1",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.dispatch.cockpit",
    "productName": "Dispatch Cockpit",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "${productName}-${version}.${ext}"
    }
  }
}
